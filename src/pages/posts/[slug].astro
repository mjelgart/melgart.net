---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

// Pagefind indexes only pages carrying data-pagefind-body once any page has
// it, so it must be undefined here to make drafts not searchable
const isDraft = entry.data.draft;
const pagefindBody = isDraft ? undefined : true;

const description = entry.data.subtitle ?? "Within cells interlinked.";

const formattedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(new Date(entry.data.date));
---

<Layout title={entry.data.title} description={description} noindex={isDraft}>
  <article data-pagefind-body={pagefindBody}>
    {isDraft && (
      <p class="draftNotice">
        <strong>Draft.</strong> This post is unfinished and isn't linked from
        anywhere on the site. It may change or disappear.
      </p>
    )}
    <h1 class="headingXl">{entry.data.title}</h1>
    <div class="lightText">
      <time datetime={entry.data.date}>{formattedDate}</time>
    </div>
    <Content />
  </article>
</Layout>

<style>
  .draftNotice {
    margin: 1rem 0 0;
    padding: 0.75rem 1rem;
    background-color: var(--surface);
    border: 1px dashed var(--border-strong);
    color: var(--text-muted);
    font-size: 0.9rem;
  }
</style>
