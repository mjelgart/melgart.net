---
import { Font } from 'astro:assets';

import '../styles/global.css';
import '../styles/utils.css';

export interface Props {
  title: string;
  description: string;
  home?: boolean;
  /** Open Graph object type. Posts are 'article'; everything else is a page. */
  ogType?: 'website' | 'article';
  /** Keep the page out of search engines. Used for public drafts, which are
      unlinked on the site but would otherwise be crawled from a shared link. */
  noindex?: boolean;
}

const { title, description, home = false, noindex = false, ogType = 'website' } = Astro.props;
const name = 'melgart.net';

// Every page must advertise its own URL. Facebook and other scrapers treat
// og:url as the canonical identity of the thing being shared: point it at the
// home page and every shared post collapses into the home page's title.
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/images/window preview.jpg', Astro.site);
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- Favicon -->
  <link rel="icon" href="/favicon-16x16.png" />

  <!-- Literata (prose) and Source Code Pro (code, wordmark), both SIL OFL.
       Configured in astro.config.mjs: Astro downloads them at build time and
       serves them from this origin, so nothing is fetched from Google at
       runtime. Only upright Literata preloads: it is what blocks first read,
       while the italic is not needed until well into a post. -->
  <Font cssVariable="--font-body" preload={[{ style: 'normal' }]} />
  <Font cssVariable="--font-mono" />

  <!-- Feed autodiscovery: lets readers subscribe by pasting the site URL -->
  <link rel="alternate" type="application/rss+xml" title={name} href="/rss.xml" />

  <!-- Basic meta -->
  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  <link rel="canonical" href={canonicalURL} />

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content={name} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:url" content={canonicalURL} />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta property="twitter:domain" content="melgart.net" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <!-- Tints mobile browser chrome; kept current by the pre-paint script below -->
  <meta name="theme-color" content="#ffffff" />

  <!-- Pre-paint theme init: must run before first render to avoid a flash of light mode -->
  <script is:inline>
    (function () {
      var stored;
      try { stored = localStorage.getItem('theme'); } catch (e) {}
      var theme = (stored === 'light' || stored === 'dark')
        ? stored
        : (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.dataset.theme = theme;

      // Literals, because global.css may not be parsed yet. Keep in sync with --bg.
      var meta = document.querySelector('meta[name="theme-color"]');
      if (meta) meta.setAttribute('content', theme === 'dark' ? '#1c1a16' : '#ffffff');
    })();
  </script>
</head>
<body>
  <div class="container">
    {home ? (
      <header class="homePageHeader">
        <img
          src="/images/profile.jpg"
          width="144"
          height="144"
          alt=""
        />
      </header>
    ) : (
      <header class="header">
        <h2 class="headingLg wordmark">
          <a href="/" class="colorInherit">
            {name}
          </a>
        </h2>
      </header>
    )}

    <main>
      <slot />
    </main>

    {!home && (
      <div class="backToHome">
        <a href="/">← Back to home</a>
      </div>
    )}

    <footer class="footer">
      <button id="theme-toggle" type="button">
        <span class="whenLight">[ dark mode ]</span>
        <span class="whenDark">[ light mode ]</span>
      </button>
    </footer>
  </div>

  <script>
    const toggle = document.getElementById('theme-toggle')!;
    const themeMeta = document.querySelector('meta[name="theme-color"]');

    function syncTheme() {
      const dark = document.documentElement.dataset.theme === 'dark';
      toggle.setAttribute('aria-pressed', String(dark));

      // Read --bg back from CSS so the chrome can't drift from the palette
      const bg = getComputedStyle(document.documentElement)
        .getPropertyValue('--bg').trim();
      if (themeMeta && bg) themeMeta.setAttribute('content', bg);
    }

    syncTheme();

    toggle.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      try { localStorage.setItem('theme', next); } catch (e) {}
      syncTheme();
    });
  </script>
</body>
</html>

<style>
  .container {
    max-width: 48rem;
    padding: 0 1rem;
    margin: 3rem auto 6rem;
  }

  .header {
    display: flex;
    flex-direction: column;
    align-items: left;
  }

  .homePageHeader {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .backToHome {
    margin: 3rem 0 0;
  }

  .footer {
    margin: 4rem 0 0;
    text-align: center;
  }

  .footer button {
    font-family: inherit;
    font-size: 0.9rem;
    color: var(--text-muted);
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
  }

  .footer button:hover {
    text-decoration: underline;
  }

  /* Keyed off data-theme (stamped pre-paint) so the label is right at
     first paint, with no post-load JS correction to flash through */
  .footer .whenDark {
    display: none;
  }

  :global(html[data-theme='dark']) .footer .whenLight {
    display: none;
  }

  :global(html[data-theme='dark']) .footer .whenDark {
    display: inline;
  }
</style>