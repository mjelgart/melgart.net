{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": [
        "http://localhost/",
        "http://localhost/posts/",
        "http://localhost/posts/the-dispossessed/",
        "http://localhost/sports/",
        "http://localhost/stats/"
      ],
      "numberOfRuns": 1
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*",
          "assertions": {
            "categories:performance": ["warn", { "minScore": 0.8 }],
            "categories:best-practices": ["warn", { "minScore": 1 }],
            "categories:seo": ["warn", { "minScore": 1 }]
          }
        },
        {
          "matchingUrlPattern": "^(?!.*/(sports|stats)/$).*$",
          "assertions": { "categories:accessibility": ["error", { "minScore": 1 }] }
        },
        {
          "matchingUrlPattern": "/sports/$",
          "assertions": { "categories:accessibility": ["error", { "minScore": 0.92 }] }
        },
        {
          "matchingUrlPattern": "/stats/$",
          "assertions": { "categories:accessibility": ["error", { "minScore": 0.95 }] }
        }
      ]
    }
  }
}
